# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# OIDC (generic-oauth plugin, provider-agnostic via discovery)
# OIDC_ISSUER_URL is the base issuer, WITHOUT the /.well-known/... suffix
# For PLANTdataHUB this is also the GitLab REST API base URL (e.g. https://git.nfdi4plants.org) —
# the OIDC access token is a GitLab OAuth token reused against /api/v4 to browse and download ARCs.
OIDC_ISSUER_URL="https://issuer.example.com"
OIDC_CLIENT_ID="change-me"
# Leave empty for a public client (PKCE, no secret)
OIDC_CLIENT_SECRET=""
# read_api is required so the token can call GitLab's REST API (listing/downloading ARCs)
OIDC_SCOPES="openid profile email api"
