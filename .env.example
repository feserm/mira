# All variables below are validated once at server start (src/lib/server/env.ts).
# A missing or malformed required variable aborts startup with one error listing every problem.
# `pnpm build` does not need any of them.

# --- Database ---------------------------------------------------------------
# Required. postgres:// or postgresql:// URL.
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"
# Max connections per app process (default 10). Total = replicas x this value.
DB_POOL_MAX=10
# Seconds before an idle connection is closed (default: never).
# DB_IDLE_TIMEOUT=
# Seconds to wait when opening a connection (default 30).
# DB_CONNECT_TIMEOUT=
# TLS to Postgres. Unset or "false" = no TLS (default). One of: true (= require), require,
# allow, prefer, verify-full. verify-full checks the server certificate against the system CAs;
# for a private CA, point NODE_EXTRA_CA_CERTS at the CA bundle.
# DB_SSL=
# Named prepared statements (default true). Set to false only behind a PgBouncer in transaction mode
# that is older than 1.21 or has max_prepared_statements=0: there a statement prepared on one server
# connection is missing on the next ("prepared statement ... does not exist"). See docs/infrastructure.md.
# DB_PREPARE=true

# --- Public URL -------------------------------------------------------------
# Required. The externally visible origin: scheme + host (+ port), no path, no trailing slash.
# Must be https unless NODE_ENV is development or test (local dev: http://localhost:5173).
# It drives the OIDC redirect URI (<ORIGIN>/api/auth/oauth2/callback/oidc), cookie flags and
# SvelteKit's CSRF origin check, so it must match what the browser sees.
#
# Behind a TLS-terminating ingress/reverse proxy, adapter-node itself also needs to know the
# original request details (these are read by adapter-node, not validated by MIRA). Either rely on
# ORIGIN alone, or additionally set:
#   PROTOCOL_HEADER=x-forwarded-proto
#   HOST_HEADER=x-forwarded-host
#   XFF_DEPTH=1   # number of trusted proxies; with ADDRESS_HEADER=x-forwarded-for for client IPs
# Only enable these when the proxy overwrites the headers, otherwise clients can spoof them.
ORIGIN=""

# --- Better Auth ------------------------------------------------------------
# Required, at least 32 characters, high entropy (e.g. `openssl rand -base64 32`).
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Optional, comma separated e-mail addresses. A user who signs in with one of these becomes admin
# (the operations role: dashboard); everyone else is a plain user, and a user no longer listed is
# demoted at their next sign-in. Compared case-insensitively against the e-mail PLANTdataHUB reports.
# ADMIN_EMAILS="admin@example.org,ops@example.org"

# --- OIDC (generic-oauth plugin, provider-agnostic via discovery) ------------
# Required. Base issuer URL, WITHOUT a trailing slash and WITHOUT the /.well-known/... suffix.
# For PLANTdataHUB this is also the GitLab REST API base URL (e.g. https://git.nfdi4plants.org) —
# the OIDC access token is a GitLab OAuth token reused against /api/v4 to browse and download ARCs.
OIDC_ISSUER_URL="https://issuer.example.com"
# Required.
OIDC_CLIENT_ID="change-me"
# Optional. Leave empty for a public client (PKCE, no secret).
OIDC_CLIENT_SECRET=""
# Optional, space separated (default "openid profile email").
# The token must be able to call GitLab's REST API (listing/downloading ARCs); read_api is the
# minimum that should be needed, "api" is broader.
OIDC_SCOPES="openid profile email api"

# --- Outbound HTTP (PLANTdataHUB) ---------------------------------------------
# Every outbound request has two limits: time until the response headers arrive, and total time
# including the body. A timeout is reported as a readable error (and retried in the worker).
# HTTP_HEADERS_TIMEOUT=30   # seconds, default 30
# HTTP_TIMEOUT=300          # seconds, default 300, must be >= HTTP_HEADERS_TIMEOUT

# --- Metrics (S2.8; see docs/observability.md) -----------------------------------
# Bearer token that opens GET /metrics, at least 32 characters. Unset: the endpoint answers 404.
# It is not a MIRA API token and not a session. Chart: secrets.metricsToken.
# METRICS_TOKEN=""

# --- request_logs retention (node retention.js; read by that job only, not by the app) ---
# REQUEST_LOGS_RETENTION_DAYS=90    # rows older than this are deleted
# REQUEST_LOGS_RETENTION_BATCH=5000 # rows per delete statement

# --- ETL worker (node worker.js; see docs/etl-worker.md) ------------------------
# The worker needs the same DATABASE_URL, ORIGIN, BETTER_AUTH_SECRET and OIDC_* as the web app
# (it refreshes the importing user's PLANTdataHUB token through better-auth).
# ETL_CONCURRENCY=1          # jobs run in parallel per worker process (DB_POOL_MAX should be >= this + 2)
# ETL_LEASE_SECONDS=60       # a job whose lease is not renewed for this long is reclaimed (min 10)
# ETL_POLL_SECONDS=5         # how often an idle worker looks for jobs
# ETL_MAX_ATTEMPTS=3         # attempts per job; only transient failures (network, timeouts, 5xx) retry
# ETL_RETRY_DELAY_SECONDS=30 # delay before a retry = this x attempt number
# ETL_SHUTDOWN_TIMEOUT=60    # seconds a stopping worker waits for running jobs before handing them back
