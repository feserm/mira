{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["image", "secrets", "config"],
	"properties": {
		"replicaCount": {
			"type": "integer",
			"minimum": 1
		},
		"image": {
			"type": "object",
			"required": ["repository", "tag"],
			"properties": {
				"repository": {
					"type": "string",
					"minLength": 1
				},
				"tag": {
					"type": "string",
					"minLength": 1,
					"description": "Full commit SHA published by CI. There is no latest tag."
				},
				"digest": {
					"type": "string",
					"pattern": "^(sha256:[0-9a-f]{64})?$"
				},
				"pullPolicy": {
					"enum": ["Always", "IfNotPresent", "Never"]
				}
			}
		},
		"secrets": {
			"type": "object",
			"required": ["database", "authSecret"],
			"properties": {
				"database": {
					"$ref": "#/definitions/requiredSecretRef"
				},
				"authSecret": {
					"$ref": "#/definitions/requiredSecretRef"
				},
				"oidcClientSecret": {
					"type": "object",
					"properties": {
						"name": {
							"type": "string"
						},
						"key": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				"metricsToken": {
					"type": "object",
					"properties": {
						"name": {
							"type": "string",
							"description": "Existing Secret holding METRICS_TOKEN (at least 32 characters); empty = /metrics does not exist (404)"
						},
						"key": {
							"type": "string",
							"minLength": 1
						}
					}
				}
			}
		},
		"config": {
			"type": "object",
			"required": ["oidc"],
			"properties": {
				"origin": {
					"type": "string",
					"pattern": "^(https://[^/\\s]+)?$",
					"description": "https://host, no path, no trailing slash"
				},
				"adminEmails": {
					"type": "string",
					"pattern": "^([^,\\s@]+@[^,\\s@]+(\\s*,\\s*[^,\\s@]+@[^,\\s@]+)*)?$",
					"description": "comma separated e-mail addresses made admin at sign-in"
				},
				"oidc": {
					"type": "object",
					"required": ["issuerUrl", "clientId"],
					"properties": {
						"issuerUrl": {
							"type": "string",
							"pattern": "^https?://[^\\s]+[^/\\s]$",
							"description": "OIDC issuer (PLANTdataHUB) URL, no trailing slash"
						},
						"clientId": {
							"type": "string",
							"minLength": 1
						},
						"scopes": {
							"type": "string"
						}
					}
				},
				"shutdownTimeout": {
					"type": "integer",
					"minimum": 1
				},
				"http": {
					"type": "object",
					"properties": {
						"headersTimeout": {
							"type": ["integer", "string"],
							"pattern": "^[0-9]*$",
							"minimum": 1
						},
						"timeout": {
							"type": ["integer", "string"],
							"pattern": "^[0-9]*$",
							"minimum": 1
						}
					}
				},
				"etl": {
					"type": "object",
					"properties": {
						"maxAttempts": {
							"type": "integer",
							"minimum": 1
						},
						"retryDelaySeconds": {
							"type": "integer",
							"minimum": 0
						}
					}
				},
				"db": {
					"type": "object",
					"properties": {
						"poolMax": {
							"type": "integer",
							"minimum": 1
						},
						"idleTimeout": {
							"type": ["integer", "string"],
							"pattern": "^[0-9]*$"
						},
						"connectTimeout": {
							"type": ["integer", "string"],
							"pattern": "^[0-9]*$",
							"minimum": 1
						},
						"ssl": {
							"type": "string",
							"enum": ["", "true", "false", "require", "allow", "prefer", "verify-full"],
							"description": "DB_SSL; empty = off"
						},
						"prepare": {
							"type": "string",
							"enum": ["", "true", "false"],
							"description": "DB_PREPARE; empty = app default (true). false only behind an old PgBouncer"
						},
						"caSecret": {
							"type": "object",
							"properties": {
								"name": {
									"type": "string",
									"description": "Existing Secret holding the CA that signed the Postgres server certificate; empty = none"
								},
								"key": {
									"type": "string",
									"minLength": 1
								}
							}
						}
					}
				}
			}
		},
		"migration": {
			"type": "object",
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"databaseSecret": {
					"type": "object",
					"properties": {
						"name": {
							"type": "string"
						},
						"key": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				"backoffLimit": {
					"type": "integer",
					"minimum": 0
				},
				"activeDeadlineSeconds": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"ingress": {
			"type": "object",
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"host": {
					"type": "string",
					"pattern": "^[^/\\s:]*$"
				}
			},
			"if": {
				"properties": {
					"enabled": {
						"const": true
					}
				},
				"required": ["enabled"]
			},
			"then": {
				"required": ["host"],
				"properties": {
					"host": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		},
		"worker": {
			"type": "object",
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"replicas": {
					"type": "integer",
					"minimum": 0
				},
				"concurrency": {
					"type": "integer",
					"minimum": 1
				},
				"leaseSeconds": {
					"type": "integer",
					"minimum": 10
				},
				"pollSeconds": {
					"type": "integer",
					"minimum": 1
				},
				"shutdownTimeoutSeconds": {
					"type": "integer",
					"minimum": 0
				},
				"terminationGracePeriodSeconds": {
					"type": ["integer", "string"],
					"pattern": "^[0-9]*$"
				},
				"podDisruptionBudget": {
					"type": "object",
					"properties": {
						"enabled": {
							"type": "boolean"
						},
						"maxUnavailable": {
							"type": "integer",
							"minimum": 1
						}
					}
				}
			}
		},
		"retention": {
			"type": "object",
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"schedule": {
					"type": "string",
					"pattern": "^\\S+( \\S+){4}$",
					"description": "cron expression, five fields"
				},
				"days": {
					"type": "integer",
					"minimum": 30,
					"description": "The dashboard's daily chart shows 30 days"
				},
				"batchSize": {
					"type": "integer",
					"minimum": 100,
					"maximum": 100000
				},
				"activeDeadlineSeconds": {
					"type": "integer",
					"minimum": 60
				}
			}
		},
		"monitoring": {
			"type": "object",
			"properties": {
				"serviceMonitor": {
					"type": "object",
					"properties": {
						"enabled": {
							"type": "boolean"
						},
						"interval": {
							"type": "string",
							"pattern": "^[0-9]+(ms|s|m|h)$"
						},
						"scrapeTimeout": {
							"type": "string",
							"pattern": "^[0-9]+(ms|s|m|h)$"
						},
						"labels": {
							"type": "object",
							"additionalProperties": {
								"type": "string"
							}
						}
					}
				},
				"prometheusRule": {
					"type": "object",
					"properties": {
						"enabled": {
							"type": "boolean"
						},
						"labels": {
							"type": "object",
							"additionalProperties": {
								"type": "string"
							}
						},
						"errorRatio": {
							"type": "number",
							"exclusiveMinimum": 0,
							"maximum": 1
						},
						"slowRequestSeconds": {
							"type": "number",
							"exclusiveMinimum": 0
						},
						"importQueueAgeSeconds": {
							"type": "integer",
							"minimum": 60
						},
						"postgres": {
							"type": "object",
							"properties": {
								"enabled": {
									"type": "boolean"
								},
								"namespace": {
									"type": "string"
								},
								"clusterName": {
									"type": "string",
									"minLength": 1
								},
								"selector": {
									"type": "string",
									"description": "Prometheus label matchers, e.g. cnpg_cluster=\"mira-pg\""
								},
								"backupMaxAgeHours": {
									"type": "integer",
									"minimum": 1
								},
								"connectionRatio": {
									"type": "number",
									"exclusiveMinimum": 0,
									"maximum": 1
								}
							}
						}
					}
				}
			}
		}
	},
	"if": {
		"properties": {
			"ingress": {
				"properties": {
					"enabled": {
						"const": false
					}
				},
				"required": ["enabled"]
			}
		},
		"required": ["ingress"]
	},
	"then": {
		"properties": {
			"config": {
				"properties": {
					"origin": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": ["origin"]
			}
		}
	},
	"definitions": {
		"requiredSecretRef": {
			"type": "object",
			"required": ["name", "key"],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1,
					"description": "Name of an existing Secret in the release namespace"
				},
				"key": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"monitoring": {
						"properties": {
							"serviceMonitor": {
								"properties": {
									"enabled": {
										"const": true
									}
								},
								"required": ["enabled"]
							}
						},
						"required": ["serviceMonitor"]
					}
				},
				"required": ["monitoring"]
			},
			"then": {
				"properties": {
					"secrets": {
						"properties": {
							"metricsToken": {
								"properties": {
									"name": {
										"type": "string",
										"minLength": 1
									}
								},
								"required": ["name"]
							}
						},
						"required": ["metricsToken"]
					}
				},
				"required": ["secrets"]
			}
		}
	]
}
